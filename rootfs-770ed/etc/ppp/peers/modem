# Dial-up template: PCMCIA serial modem / MWave UART path / external serial modem
#
# Usage:  pppd call modem      (after filling in the account below)
# Account: add one line to /etc/ppp/chap-secrets or /etc/ppp/pap-secrets:
#            "your-login" * "your-password"
#
# Adjust device and speed to reality: a PCMCIA serial modem on the 770ED is
# usually /dev/ttyS1 (serial_cs); the MWave UART path is typically 0x2f8 ->
# /dev/ttyS1 or /dev/ttyS0.
/dev/ttyS1 115200
connect "/usr/sbin/chat -v -f /etc/ppp/chat-dial"
noauth
defaultroute
# user "your-login"
# persist
# Old modems are sensitive about LCP echo; enable these if needed:
# noaccomp nobsdcomp nodeflate
