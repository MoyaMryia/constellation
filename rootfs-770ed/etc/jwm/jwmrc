<?xml version="1.0"?>
<!--
  Constellation OS / ThinkPad 770ED 的 JWM 配置（1024x768，Pentium II）。
  刻意做得像 IceWM：顶部任务栏 + 时钟 + 开始菜单 + 窗口按钮。

  为什么是 JWM 不是 IceWM：IceWM 是 C++，Alpine x86 的 libgcc_s/libstdc++
  在 Pentium II（无 SSE）上直接 SIGILL；JWM 是我们用 musl i486 自己编的
  纯 C 窗口管理器，二进制里 SSE 指令为 0。见 docs/thinkpad-770ed.md §7。
-->
<JWM>
  <!-- ============ 外观 ============ -->
  <WindowStyle>
    <Font>Sans-10</Font>
    <Width>4</Width>
    <Height>22</Height>
    <Corner>3</Corner>
    <Foreground>#ffffff</Foreground>
    <Background>#4a6d8c:#2b3d4f</Background>
    <Outline>#1b2733</Outline>
    <Opacity>1.0</Opacity>
    <Active>
      <Foreground>#ffffff</Foreground>
      <Background>#4a6d8c:#1f5f8b</Background>
      <Outline>#12222e</Outline>
    </Active>
    <Inactive>
      <Foreground>#c8d4e0</Foreground>
      <Background>#46535f:#323a42</Background>
      <Outline>#1b2733</Outline>
    </Inactive>
  </WindowStyle>

  <TaskListStyle>
    <Font>Sans-10</Font>
    <ActiveForeground>#ffffff</ActiveForeground>
    <ActiveBackground>#1f5f8b</ActiveBackground>
    <Foreground>#dbe6f0</Foreground>
    <Background>#323a42</Background>
  </TaskListStyle>

  <TrayStyle>
    <Font>Sans-10</Font>
    <Foreground>#dbe6f0</Foreground>
    <Background>#323a42</Background>
  </TrayStyle>

  <ClockStyle>
    <Font>Sans-10:bold</Font>
    <Foreground>#dbe6f0</Foreground>
    <Background>#323a42</Background>
  </ClockStyle>

  <PopupStyle>
    <Font>Sans-10</Font>
    <Foreground>#1b2733</Foreground>
    <Background>#eef2f6</Background>
    <Outline>#1b2733</Outline>
  </PopupStyle>

  <MenuStyle>
    <Font>Sans-10</Font>
    <Foreground>#1b2733</Foreground>
    <Background>#eef2f6</Background>
    <ActiveForeground>#ffffff</ActiveForeground>
    <ActiveBackground>#1f5f8b</ActiveBackground>
  </MenuStyle>

  <RootMenu labeled="true" height="20">
    <Program label="终端 (xterm)" icon="xterm">xterm -fa "DejaVu Sans Mono" -fs 11</Program>
    <Program label="文件管理器 (mc)" icon="folder">mc</Program>
    <Program label="系统自检 (hwcheck)" icon="info">xterm -e hwcheck</Program>
    <Separator/>
    <Menu label="网络">
      <Program label="DHCP 续租">udhcpc -i eth0 -n -q</Program>
      <Program label="接口信息">xterm -e "ip addr; sleep 30"</Program>
    </Menu>
    <Menu label="硬件">
      <Program label="PCI 设备">xterm -e "lspci; sleep 30"</Program>
      <Program label="USB 设备">xterm -e "lsusb; sleep 30"</Program>
      <Program label="帧缓冲模式">xterm -e "fbset; sleep 30"</Program>
      <Program label="声音音量">xterm -e "mixer; mixer 80; sleep 3"</Program>
    </Menu>
    <Separator/>
    <Restart label="重启窗口管理器"/>
    <Exit label="退出到控制台" confirm="false"/>
  </RootMenu>

  <!-- ============ 顶部任务栏（IceWM 风格） ============ -->
  <Tray x="0" y="0" height="26" autohide="off">
    <TrayButton label="开始">root:1</TrayButton>
    <Spacer width="8"/>
    <TaskList maxwidth="600"/>
    <Dock/>
    <Clock format="%H:%M">%H:%M</Clock>
  </Tray>

  <!-- ============ 行为 ============ -->
  <StartupCommand># 启动后可放 setxkbmap 之类</StartupCommand>
  <DoubleClickSpeed>400</DoubleClickSpeed>
  <DoubleClickDelta>2</DoubleClickDelta>
  <FocusModel>sloppy</FocusModel>
  <SnapMode distance="8">border</SnapMode>
  <MoveMode>opaque</MoveMode>
  <ResizeMode>opaque</ResizeMode>

  <Key key="Escape">exit</Key>
  <Key mask="A" key="Tab">next</Key>
  <Key mask="A" key="F4">close</Key>
  <Key mask="A" key="F10">maximize</Key>

  <Desktops width="4" height="1">
    <Background type="solid">#5a7a94</Background>
  </Desktops>
</JWM>
