<?xml version="1.0"?>
<!--
  JWM configuration for Constellation OS / ThinkPad 770ED
  (1024x768, Pentium II). Deliberately IceWM-like: top taskbar, clock,
  start menu and window buttons.

  Why JWM and not IceWM: IceWM is C++, and Alpine's x86 libgcc_s/libstdc++
  fault with SIGILL on a Pentium II (no SSE). JWM is a pure C window manager
  built here from musl i486 sources, with zero SSE instructions in the binary.
  See docs/thinkpad-770ed.md section 7.
-->
<JWM>
  <!-- ============ Appearance ============ -->
  <WindowStyle>
    <Font>Sans-10</Font>
    <Width>4</Width>
    <Height>22</Height>
    <Corner>3</Corner>
    <Foreground>#ffffff</Foreground>
    <Background>#4a6d8c:#2b3d4f</Background>
    <Outline>#1b2733</Outline>
    <Opacity>1.0</Opacity>
    <Active>
      <Foreground>#ffffff</Foreground>
      <Background>#4a6d8c:#1f5f8b</Background>
      <Outline>#12222e</Outline>
    </Active>
  </WindowStyle>

  <TaskListStyle>
    <Font>Sans-10</Font>
    <Foreground>#dbe6f0</Foreground>
    <Background>#323a42</Background>
  </TaskListStyle>

  <TrayStyle>
    <Font>Sans-10</Font>
    <Foreground>#dbe6f0</Foreground>
    <Background>#323a42</Background>
  </TrayStyle>

  <ClockStyle>
    <Font>Sans-10:bold</Font>
    <Foreground>#dbe6f0</Foreground>
    <Background>#323a42</Background>
  </ClockStyle>

  <PopupStyle>
    <Font>Sans-10</Font>
    <Foreground>#1b2733</Foreground>
    <Background>#eef2f6</Background>
    <Outline>#1b2733</Outline>
  </PopupStyle>

  <MenuStyle>
    <Font>Sans-10</Font>
    <Foreground>#1b2733</Foreground>
    <Background>#eef2f6</Background>
    <ActiveForeground>#ffffff</ActiveForeground>
    <ActiveBackground>#1f5f8b</ActiveBackground>
  </MenuStyle>

  <RootMenu labeled="true" height="20">
    <Program label="Terminal (st)" icon="xterm">st</Program>
    <Program label="System check (hwcheck)" icon="info">st -e sh -c "hwcheck; echo; echo press Enter; read _; " </Program>
    <Program label="Fetch (mark + summary)" icon="info">st -e sh -c "fetch; sleep 30"</Program>
    <Separator/>
    <Menu label="Network">
      <Program label="DHCP renew">st -e sh -c "udhcpc -i eth0 -n -q; sleep 5"</Program>
      <Program label="Interface info">st -e sh -c "ip addr; sleep 30"</Program>
      <Program label="Wi-Fi scan">st -e sh -c "wifi scan; sleep 30"</Program>
      <Program label="Wi-Fi status">st -e sh -c "wifi status; sleep 30"</Program>
    </Menu>
    <Menu label="Storage">
      <Program label="Mount USB stick">st -e sh -c "mountusb; sleep 10"</Program>
      <Program label="Unmount USB stick">st -e sh -c "mountusb -u; sleep 10"</Program>
      <Program label="Disk usage">st -e sh -c "df -k; sleep 30"</Program>
      <Program label="Partitions">st -e sh -c "cat /proc/partitions; sleep 30"</Program>
    </Menu>
    <Menu label="Hardware">
      <Program label="PCI devices">st -e sh -c "cat /sys/bus/pci/devices/*/uevent 2>/dev/null | head -n 40; sleep 30"</Program>
      <Program label="USB devices">st -e sh -c "ls /sys/bus/usb/devices; sleep 30"</Program>
      <Program label="Framebuffer mode">st -e sh -c "cat /proc/fb; sleep 30"</Program>
      <Program label="Volume">st -e sh -c "mixer; mixer 80; sleep 3"</Program>
      <Program label="Battery / AC">st -e sh -c "apm; sleep 20"</Program>
    </Menu>
    <Separator/>
    <Restart label="Restart window manager"/>
    <Exit label="Exit to console" confirm="false"/>
  </RootMenu>

  <!-- ============ Top taskbar (IceWM style) ============ -->
  <Tray x="0" y="0" height="26" autohide="off">
    <TrayButton label="Start">root:1</TrayButton>
    <Spacer width="8"/>
    <TaskList maxwidth="600"/>
    <Dock/>
    <Clock format="%H:%M">%H:%M</Clock>
  </Tray>

  <!-- ============ Behaviour ============ -->
  <DoubleClickSpeed>400</DoubleClickSpeed>
  <DoubleClickDelta>2</DoubleClickDelta>
  <FocusModel>sloppy</FocusModel>
  <SnapMode distance="8">border</SnapMode>
  <MoveMode>opaque</MoveMode>
  <ResizeMode>opaque</ResizeMode>

  <Key key="Escape">exit</Key>
  <Key mask="A" key="Tab">next</Key>
  <Key mask="A" key="F4">close</Key>
  <Key mask="A" key="F10">maximize</Key>

  <Desktops width="4" height="1">
    <Background type="solid">#5a7a94</Background>
  </Desktops>
</JWM>
