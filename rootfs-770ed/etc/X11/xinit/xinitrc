#!/bin/sh
# xinit session: run JWM directly as the session's main process (JWM is built
# here from musl i486 sources; the binary contains zero SSE instructions).
# We do not pull in xterm/xrdb by default: those are Alpine Pentium III (SSE)
# baseline binaries and fault with SIGILL on a PII. Install a self-built
# terminal if you need one (see docs/thinkpad-770ed.md section 6.1).
exec /usr/bin/jwm -f /etc/jwm/jwmrc
