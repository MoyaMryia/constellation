#!/bin/sh
# Wired DHCP: the interface name is decided by the kernel (a CardBus NIC shows
# up as eth0; the 770ED has no built-in Ethernet). Give hotplug 5 seconds to
# bind the driver, then pick the first non-lo interface.
for i in 1 2 3 4 5; do
  iface=
  for d in /sys/class/net/*; do
    n=${d##*/}
    [ "$n" = lo ] && continue
    iface=$n
    break
  done
  [ -n "$iface" ] && break
  /bin/sleep 1
done
[ -n "$iface" ] || exec /bin/sleep 3600

/bin/ip link set "$iface" up
echo "constellation: udhcpc on $iface"
exec /bin/udhcpc -f -i "$iface" -s /etc/udhcpc.script
