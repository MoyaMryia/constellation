#!/bin/sh
# Serial login. The 770ED has one 9-pin serial port (NS PC97338 SuperI/O), but
# it may be disabled in BIOS or may enumerate as ttyS1 (COM2), so look for the
# first *real* port: /sys/class/tty/ttySX/type must be non-zero (a real 8250).
#
# 115200 8N1, no flow control. Use a null-modem cable to another machine.
for n in 0 1 2 3; do
  t=/dev/ttyS$n
  [ -c "$t" ] || continue
  type=$(cat "/sys/class/tty/ttyS$n/type" 2>/dev/null)
  [ "${type:-0}" = 0 ] && continue
  exec /bin/getty -L "ttyS$n" 115200 vt100
done
# No usable serial port (local-only machine): sleep quietly, do not spam logs.
exec /bin/sleep 3600
