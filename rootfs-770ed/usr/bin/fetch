#!/bin/sh
# Constellation fetch: mark (multi-colour asterisk) on the left, system info
# on the right.
#
# Why a shell script instead of real fastfetch: this is a PII 266 with 64 MiB,
# and the whole image is audited for "no SSE instructions"
# (scripts/audit-sse-770ed.sh). fastfetch binaries carry SSE on 32-bit x86
# (memcpy / auto-vectorisation), which would mean maintaining another i486
# build line; the mark itself is only 14 lines of ASCII art plus colour, so
# busybox awk can lay out the two columns. No binary, no SSE risk.
#
# Environment:
#   FETCH_LOGO=/path   use a logo from elsewhere (default: pick by terminal)
#   NO_COLOR=1         do not emit colour
set -u

SELF_DIR=${CONSTELLATION_SHARE:-/usr/share/constellation}

# ---- 1) pick a logo: the VGA text console only does 16 colours, a truecolor
#         escape sequence would be printed literally ----
logo=$SELF_DIR/logo.txt
case ${TERM:-} in
  linux|dumb) logo=$SELF_DIR/logo16.txt ;;
esac
if [ -n "${FETCH_LOGO:-}" ]; then logo=$FETCH_LOGO; fi

# ---- 2) collect information ----
hostn=$(cat /etc/hostname 2>/dev/null || uname -n)
[ -n "$hostn" ] || hostn=constellation
who=${USER:-$(id -un 2>/dev/null || echo root)}

read_val() { # read_val <file> <key> -> first field after the colon
  awk -v k="$2" -F: '$1 == k { gsub(/^[ \t]+|[ \t]+$/, "", $2); print $2; exit }' "$1" 2>/dev/null
}

osname=$(read_val /etc/os-release NAME 2>/dev/null)
[ -n "$osname" ] || osname="Constellation OS"
kver=$(uname -r)
model=$(awk -F: '/model name/ { sub(/^[ \t]+/, "", $2); print $2; exit }' /proc/cpuinfo 2>/dev/null)
[ -n "$model" ] || model=$(awk -F: '/^cpu model/ { sub(/^[ \t]+/, "", $2); print $2; exit }' /proc/cpuinfo 2>/dev/null)
[ -n "$model" ] || model=$(uname -m)

mem=$(awk '/^MemTotal:/ { t = $2 }
           /^MemAvailable:/ { a = $2 }
           /^MemFree:/ { f = $2 }
           END {
             if (t == 0) exit
             u = (a != "") ? t - a : t - f
             printf "%d MiB / %d MiB", u / 1024, t / 1024
           }' /proc/meminfo 2>/dev/null)

swap=$(awk '/^SwapTotal:/ { t = $2 } /^SwapFree:/ { f = $2 }
            END { if (t > 0) printf "%d MiB / %d MiB", (t - f) / 1024, t / 1024 }' \
       /proc/meminfo 2>/dev/null)

up=$(awk '{ printf "%d min", $1 / 60 }' /proc/uptime 2>/dev/null)

# Display environment: if X is running, find out which WM it is (busybox ps
# puts arguments at the end of the line, so pick the program name itself)
wm=$(ps 2>/dev/null | awk '
  {
    for (i = 1; i <= NF; i++) {
      n = split($i, p, "/")
      if (p[n] ~ /^(jwm|Xvesa|Xorg|icewm|twm|st|busybox)$/) {
        if (p[n] ~ /^(jwm|icewm|twm)$/) { print p[n]; found = 1; exit }
        seen = p[n]
      }
    }
  }
  END { if (seen != "" && !found) print seen }
')
case ${wm:-} in
  jwm|icewm|twm) desk="X11 ($wm)" ;;
  Xvesa|Xorg)    desk="X11 ($wm)" ;;
  *)             desk="tty" ;;
esac

info=$(mktemp 2>/dev/null || echo /tmp/.fetch.$$)
cleanup() { rm -f "$info"; }
trap cleanup EXIT HUP INT TERM

{
  printf '\033[1m%s@%s\033[0m\n' "$who" "$hostn"
  printf '%s\n' '--------------------------'
  printf 'OS:      %s\n' "$osname"
  printf 'Kernel:  %s\n' "$kver"
  printf 'CPU:     %s\n' "$model"
  printf 'Memory:  %s\n' "$mem"
  [ -n "${swap:-}" ] && printf 'Swap:    %s\n' "$swap"
  printf 'Uptime:  %s\n' "$up"
  printf 'Shell:   %s\n' "$(basename "${SHELL:-/bin/sh}")"
  printf 'Display: %s\n' "$desk"
  # busybox df has no -h (CONFIG_FEATURE_DF_FANCY off): use -k and convert
  printf 'Disk:    %s\n' "$(df -k / 2>/dev/null | awk 'NR == 2 {
      u = $3 / 1024; t = $2 / 1024; p = (t > 0) ? (u * 100 / t) : 0
      printf "%.0f MiB / %.0f MiB (%.0f%%)", u, t, p }')"
} > "$info" 2>/dev/null

# ---- 3) merge the two columns: pad by *visible* width (ANSI stripped) ----
if [ ! -s "$info" ]; then
  cat "$logo" 2>/dev/null
  exit 0
fi
awk '
  NR == FNR {          # first pass: the logo
    art[FNR] = $0
    s = $0; gsub(/\033\[[0-9;]*m/, "", s)
    if (length(s) > w) w = length(s)
    na = FNR
    next
  }
  { info[FNR] = $0; ni = FNR }
  END {
    n = (na > ni) ? na : ni
    for (i = 1; i <= n; i++) {
      a = (i <= na) ? art[i] : ""
      t = a; gsub(/\033\[[0-9;]*m/, "", t)
      gap = w - length(t) + 3
      if (gap < 1) gap = 1
      # busybox awk does NOT support %*s (dynamic width); it aborts with
      # "awk: cmd line:N %*x formats are not supported". Build the padding.
      pad = ""
      for (j = 0; j < gap; j++) pad = pad " "
      printf "%s%s%s\n", a, pad, (i <= ni) ? info[i] : ""
    }
  }
' "$logo" "$info"
