#!/bin/sh
# wifi -- tiny Wi-Fi helper for the BCM4318 (b43) / any wext-capable card.
#
#   wifi                      scan and list access points
#   wifi scan                 same
#   wifi connect SSID [PASS]  join a network (WPA/WPA2-PSK with a passphrase,
#                             open network without one) and run DHCP
#   wifi status               driver state, ESSID, access point, address
#   wifi diag                 iwconfig + security IEs + supplicant log + dmesg
#   wifi down                 stop wpa_supplicant and take the link down
#
# Both cases go through wpa_supplicant (wext driver, internal TLS): it does the
# scan and the join itself and records why a join failed. WEP is not handled --
# edit /etc/wpa_supplicant/wpa_supplicant.conf and add wep_key0 by hand.
# DHCP is done with udhcpc and the hook in /etc/udhcpc.script.
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin
CONF=/etc/wpa_supplicant/wpa_supplicant.conf
LOG=/var/log/wpa_supplicant.log

# Every subcommand needs root: "ip link set", "killall wpa_supplicant",
# "iwlist scan" and udhcpc all need CAP_NET_ADMIN, and $CONF is 0600 root.
# Re-exec through sudo so a normal user can just type "wifi connect SSID".
if [ "$(id -u)" != 0 ]; then
  if [ -x /usr/bin/sudo ]; then
    exec /usr/bin/sudo /usr/bin/wifi "$@"
  fi
  echo "wifi: needs root (try: sudo wifi $*)" >&2
  exit 1
fi

iface() {
  for d in /sys/class/net/*; do
    n=${d##*/}
    [ "$n" = lo ] && continue
    [ -d "$d/wireless" ] && { echo "$n"; return 0; }
    [ -e "$d/phy80211" ] && { echo "$n"; return 0; }
  done
  return 1
}

# b43 loads firmware when the interface goes up; on a 266 MHz machine that
# takes a moment. Say why nothing showed up instead of printing an empty list.
no_card_hint() {
  if ! ls /lib/firmware/b43/*.fw >/dev/null 2>&1; then
    echo "wifi: no b43 firmware in /lib/firmware/b43" >&2
  else
    echo "wifi: card present but not ready -- try:" >&2
    echo "        dmesg | grep -iE 'b43|ssb|80211'" >&2
  fi
}

# Wait until the link actually carries traffic (up to $1 seconds).
# iwconfig prints "ESSID:\"...\"" as soon as the ESSID is set, even when the
# card never associated -- "Debug" above is exactly that case. The carrier flag
# is the only honest signal, and DHCP needs it.
wait_assoc() {
  i=$1; limit=$2; n=0
  while [ "$n" -lt "$limit" ]; do
    if [ "$(cat "/sys/class/net/$i/carrier" 2>/dev/null)" = 1 ]; then
      return 0
    fi
    # Fallback for drivers without a carrier file: require an access point too.
    if [ ! -e "/sys/class/net/$i/carrier" ]; then
      case "$(iwconfig "$i" 2>/dev/null)" in
        *Access\ Point:\ [0-9A-Fa-f]*) return 0 ;;
      esac
    fi
    n=$((n + 1))
    /bin/sleep 1
  done
  return 1
}

cmd=${1:-scan}
case $cmd in
  scan)
    i=$(iface) || { echo "wifi: no wireless interface -- is the card inserted?"; no_card_hint; exit 1; }
    ip link set "$i" up 2>/dev/null
    /bin/sleep 1
    echo "wifi: scanning on $i ..."
    out=$(iwlist "$i" scan 2>/dev/null)
    if [ -z "$out" ]; then
      echo "wifi: scan returned nothing"
      no_card_hint
      exit 1
    fi
    echo "$out" | awk '
      /Cell [0-9]+ - Address/ { essid = ""; sig = ""; enc = "open" }
      /ESSID:/ { sub(/.*ESSID:/, ""); gsub(/"/, ""); essid = $0 }
      /Signal level/ { sub(/.*Signal level[=:]/, ""); sig = $0 }
      /Encryption key:on/ { enc = "WPA/WEP" }
      /^ *$/ { if (essid != "") printf "  %-24s %-12s %s\n", essid, sig, enc }
      END { if (essid != "") printf "  %-24s %-12s %s\n", essid, sig, enc }
    ' | head -n 20
    ;;
  connect)
    [ $# -ge 2 ] || { echo "usage: wifi connect SSID [PASSPHRASE]"; exit 1; }
    ssid=$2; psk=${3:-}
    i=$(iface) || { echo "wifi: no wireless interface -- is the card inserted?"; no_card_hint; exit 1; }
    ip link set "$i" up 2>/dev/null
    # A supplicant left over from an earlier connect owns the interface.
    killall wpa_supplicant 2>/dev/null

    # One code path for both cases. Joining with "iwconfig essid" used to be the
    # open-network shortcut, and it fails quietly: the ESSID gets stored, the
    # card never associates, and the status line reads
    # ESSID:"Debug"  Access Point: Not-Associated -- with no error anywhere,
    # because iwconfig's message was sent to /dev/null. wpa_supplicant does the
    # scan and the join itself and writes down why it failed.
    mkdir -p /var/run/wpa_supplicant /var/log
    if [ -n "$psk" ]; then
      cat > "$CONF" <<WCONF
ctrl_interface=/var/run/wpa_supplicant
update_config=1

network={
	ssid="$ssid"
	psk="$psk"
}
WCONF
    else
      echo "wifi: no passphrase given -- open network (key_mgmt=NONE)"
      cat > "$CONF" <<WCONF
ctrl_interface=/var/run/wpa_supplicant
update_config=1

network={
	ssid="$ssid"
	key_mgmt=NONE
}
WCONF
    fi
    chmod 0600 "$CONF"
    : > "$LOG"
    if ! wpa_supplicant -B -f "$LOG" -i "$i" -c "$CONF"; then
      echo "wifi: wpa_supplicant would not start" >&2
      tail -n 10 "$LOG" 2>/dev/null | sed 's/^/  /' >&2
      exit 1
    fi
    echo "wifi: supplicant started on $i, waiting for the link ..."

    # DHCP before the carrier is up gets nothing, and on a 266 MHz machine with
    # firmware loaded on demand that takes a while. Wait for carrier.
    if wait_assoc "$i" 20; then
      echo "wifi: link up on $i"
      # Association can succeed and the 4-way handshake still fail: the card
      # then drops the link about a second later and the address never comes.
      if grep -q "4-Way Handshake failed\|pre-shared key may be incorrect" "$LOG" 2>/dev/null; then
        echo "wifi: WPA handshake failed after association" >&2
        echo "        wrong passphrase, or the b43 crypto engine;" >&2
        echo "        /etc/modprobe.d/b43.conf sets nohwcrypt=1 -- check: wifi diag" >&2
        tail -n 6 "$LOG" 2>/dev/null | sed 's/^/  /' >&2
      fi
    else
      echo "wifi: no carrier on $i after 20 s" >&2
      echo "        wrong SSID? out of range? 5 GHz-only network? (b43 is 2.4 GHz)" >&2
      tail -n 8 "$LOG" 2>/dev/null | sed 's/^/  /' >&2
      no_card_hint
    fi

    echo "wifi: requesting DHCP lease ..."
    # -s is mandatory: without it udhcpc looks for
    # /usr/share/udhcpc/default.script. This image shipped no such file until
    # now, so a lease was obtained and then thrown away -- the interface kept
    # no address, no route and no resolver, which reads as "DHCP failed".
    # -t 5 -T 3: five tries, three seconds apart.
    if udhcpc -n -q -s /etc/udhcpc.script -t 5 -T 3 -i "$i"; then
      ip addr show "$i" 2>/dev/null | awk '/inet / { print "wifi: address " $2 }'
      ip route 2>/dev/null | awk '$1 == "default" { print "wifi: gateway " $3 }'
      awk '/^nameserver/ { print "wifi: dns " $2 }' /etc/resolv.conf 2>/dev/null
    else
      echo "wifi: DHCP failed -- no lease. Check the link first:" >&2
      echo "        cat /sys/class/net/$i/carrier   (want 1)" >&2
      echo "        wifi diag" >&2
    fi
    ;;
  status)
    i=$(iface) || { echo "wifi: no wireless interface"; exit 1; }
    iwconfig "$i" 2>/dev/null
    ip addr show "$i" 2>/dev/null | sed -n '1,4p'
    ;;
  diag)
    echo "=== interface"
    iface || { echo "  none -- card not inserted, or its driver is not loaded"; no_card_hint; exit 1; }
    i=$(iface)
    echo
    echo "=== iwconfig $i"
    iwconfig "$i" 2>/dev/null | sed 's/^/  /'
    echo
    echo "=== address"
    ip addr show "$i" 2>/dev/null | sed 's/^/  /'
    echo
    echo "=== access points and their security"
    iwlist "$i" scan 2>/dev/null \
      | grep -E 'ESSID|Protocol|Group Cipher|Pairwise Ciphers|Authentication Suites|IE: ' \
      | sed 's/^ *//' | sed 's/^/  /' | head -n 40
    echo
    echo "=== driver parameter"
    v=$(cat /sys/module/b43/parameters/nohwcrypt 2>/dev/null)
    echo "  nohwcrypt=${v:-?}   (1 = software crypto; see /etc/modprobe.d/b43.conf)"
    echo
    echo "=== wpa_supplicant log (tail)"
    tail -n 12 "$LOG" 2>/dev/null | sed 's/^/  /' || echo "  (no log yet)"
    echo
    echo "=== kernel, b43 and cfg80211"
    dmesg 2>/dev/null | grep -iE 'b43|ssb|cfg80211|wlan0' | tail -n 12 | sed 's/^/  /'
    ;;
  down)
    i=$(iface) || { echo "wifi: no wireless interface"; exit 1; }
    killall wpa_supplicant 2>/dev/null
    ip link set "$i" down 2>/dev/null
    echo "wifi: $i down"
    ;;
  *) echo "usage: wifi [scan|connect SSID [PASSPHRASE]|status|diag|down]"; exit 1 ;;
esac
