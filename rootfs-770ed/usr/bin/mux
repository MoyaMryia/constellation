#!/bin/sh
# mux -- abduco + dvtm, the small tmux.
#
#   mux                 attach session "main", creating it if needed
#   mux NAME            same, with another name
#   mux -l              list sessions
#
# Detach with Ctrl-\ ; the session keeps running. Reconnect with "mux NAME".
# To end a session, exit the shell inside it (or run exit in every window).
# Inside dvtm: Ctrl-G opens the key help, Ctrl-N cycles windows, Ctrl-C makes
# a new one.
#
# Why not tmux: tmux needs libevent, a full terminfo database and about 1.5 MB
# of static binary. abduco carries the detach/attach half in 76 KB with no
# dependencies; dvtm adds tiling windows for another 300 KB. On a 266 MHz
# machine that difference is visible.
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin

case ${1:-} in
  -l|--list) exec abduco -l ;;
  -h|--help)
    sed -n '2,11s/^# \{0,1\}//p' "$0"
    exit 0 ;;
esac

name=${1:-main}

# dvtm draws windows and needs a usable terminal. On a serial console that has
# no TERM, or a dumb one, a plain shell is the honest fallback.
if command -v dvtm >/dev/null 2>&1; then
  case ${TERM:-} in
    ""|dumb|unknown) exec abduco -A "$name" /bin/sh ;;
    *)               exec abduco -A "$name" dvtm ;;
  esac
fi
exec abduco -A "$name" /bin/sh
