#!/bin/sh
# 在 VT2 上启动 Xorg + IceWM（VT1 留给 getty 登录）。
#
# 视频驱动二选一：
#   /dev/fb0 存在 → fbdev（真机走这里：tridentfb 已经把 Cyber9397DVD 设成
#                          1024x768-16，X 直接在帧缓冲上画）
#   否则          → vesa （BIOS 的 VBE 3.0 接口；QEMU 里验收走这条路）
#
# 输入：没有 udev，所以按 /proc/bus/input/devices 里的 Handlers 找到
# 键盘与鼠标（TrackPoint 就是 PS/2 AUX）对应的 eventN，写进临时
# xorg.conf。Xorg 21 的 evdev 驱动只认显式 /dev/input/eventX 路径。
set -e
export PATH=/usr/bin:/usr/sbin:/bin:/sbin
CONF=/tmp/xorg.conf

fb_event() {
  awk -v want="$1" '
    /^I: Bus=/ { dev=""; kbd=0; mouse=0 }
    /^N: Name=/ { name=$0; sub(/^N: Name=/, "", name) }
    /^H: Handlers=/ { h=$0; sub(/^H: Handlers=/, "", h);
      n=split(h, a, " "); for (i = 1; i <= n; i++) {
        if (a[i] ~ /^event[0-9]+$/) dev = a[i];
        if (a[i] == "kbd") kbd = 1;
        if (a[i] == "mouse") mouse = 1;
      }
      if (want == "kbd" && kbd && dev != "") { print dev; exit }
      if (want == "mouse" && mouse && dev != "") { print dev; exit }
    }' /proc/bus/input/devices
}

if [ -e /dev/fb0 ]; then
  DRIVER=fbdev
  EXTRA='    Option "fbdev" "/dev/fb0"'
else
  DRIVER=vesa
  EXTRA='    Option "ModeSetClearScreen" "off"'
fi

KBD=$(fb_event kbd);  [ -n "$KBD" ]   || KBD=event0
MOUSE=$(fb_event mouse); [ -n "$MOUSE" ] || MOUSE=event1

cat > "$CONF" <<CONFEOF
Section "ServerLayout"
    Identifier "Layout0"
    Screen 0 "Screen0" 0 0
    InputDevice "Keyboard0" "CoreKeyboard"
    InputDevice "Mouse0" "CorePointer"
EndSection

Section "ServerFlags"
    Option "AutoAddDevices" "false"
    Option "DontZap" "false"
EndSection

Section "Device"
    Identifier "Card0"
    Driver "$DRIVER"
$EXTRA
EndSection

Section "Monitor"
    Identifier "Panel"
    HorizSync   30.0 - 70.0
    VertRefresh 50.0 - 75.0
    Option "DPMS" "false"
    Modeline "1024x768" 65.00 1024 1048 1184 1344 768 771 777 806 -hsync -vsync
EndSection

Section "Screen"
    Identifier "Screen0"
    Device "Card0"
    Monitor "Panel"
    DefaultDepth 16
    SubSection "Display"
        Depth 16
        Modes "1024x768"
    EndSubSection
EndSection

# 输入驱动用 kbd + mouse（老式、走 /dev/ttyX 与 /dev/input/mice），
# 不用 evdev：evdev 硬依赖 libudev，而 eudev 也是 SSE 基线（实测 SIGILL）。
Section "InputDevice"
    Identifier "Keyboard0"
    Driver "kbd"
    Option "AutoRepeat" "500 30"
EndSection

Section "InputDevice"
    Identifier "Mouse0"
    Driver "mouse"
    Option "Protocol" "IMPS/2"
    Option "Device" "/dev/input/mice"
    Option "Emulate3Buttons" "true"
    Option "ZAxisMapping" "4 5"
EndSection
CONFEOF

mkdir -p /tmp/.X11-unix /var/log
chmod 1777 /tmp/.X11-unix 2>/dev/null || true
# 上一次 X 崩掉留下的锁会让新实例直接报 "Server is already active"。
rm -f /tmp/.X0-lock /tmp/.X11-unix/X0 2>/dev/null || true

echo "x: driver=$DRIVER kbd=/dev/input/$KBD mouse=/dev/input/$MOUSE"
# Xorg 21 的权限检查：以 root 运行时 -config 只接受**相对路径**（且不能含
# ".."），所以先 cd 到 /tmp 再用文件名传参。绝对路径会被拒绝：
#   "Invalid argument for -config ... must specify a relative path"
cd /tmp || exit 1
xinit /etc/X11/xinit/xinitrc -- /usr/bin/X :0 -config xorg.conf -logfile /tmp/X.log -nolisten tcp vt2
# X 退出后回到 getty 所在的 VT1
chvt 1 2>/dev/null || true
