#!/bin/sh
# ThinkPad 770ED hardware self-check report. Run it on the target: hwcheck
# Each section corresponds to one acceptance item in docs/thinkpad-770ed.md.
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

sec () { echo; echo "== $* =="; }

sec kernel
uname -a

sec cpu
grep -E '^(model name|cpu MHz|flags)' /proc/cpuinfo | head -n 3

sec memory
grep -E '^(MemTotal|MemFree|SwapTotal|SwapFree)' /proc/meminfo
[ -r /proc/swaps ] && cat /proc/swaps

sec pci
if command -v lspci >/dev/null 2>&1; then lspci; else ls /sys/bus/pci/devices; fi

sec usb
if command -v lsusb >/dev/null 2>&1; then lsusb; else ls /sys/bus/usb/devices; fi

sec pcmcia
for d in /sys/class/pcmcia_socket/*; do
  [ -e "$d" ] || continue
  echo "socket ${d##*/}: $(cat "$d/card_type" 2>/dev/null) ready=$(cat "$d/card_ready" 2>/dev/null)"
done
cat /proc/ioports 2>/dev/null | grep -i -E 'cardbus|pcmcia' | head -n 5

sec framebuffer
cat /proc/fb 2>/dev/null || echo "no /proc/fb"
command -v fbset >/dev/null 2>&1 && fbset 2>/dev/null | head -n 8

sec sound
cat /proc/asound/cards 2>/dev/null || echo "no /proc/asound (snd-cs4236 not loaded, or no CS4237B detected)"
cat /proc/asound/devices 2>/dev/null | head -n 5

sec firmware
ls /lib/firmware 2>/dev/null || echo "no /lib/firmware"

sec storage
cat /proc/partitions
echo "-- a PCMCIA/CF adapter should show up as sdX (pata_pcmcia); check dmesg after inserting"

sec modem
ls /dev/modems 2>/dev/null || echo "MWave not initialised (see /etc/modprobe.d/mwave.conf)"

sec apm
cat /proc/apm 2>/dev/null || echo "no APM (kernel built without APM, or the BIOS does not provide it)"

sec interrupts
cat /proc/interrupts

sec modules
lsmod 2>/dev/null | head -n 30
