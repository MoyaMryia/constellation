#!/bin/sh
# osupdate -- install an OS/package update from a .upd bundle (USB stick or path).
#
# Bundle format (produced by scripts/make-osupdate-770ed.sh):
#   VERSION           plain text: version, build date, kernel, file count
#   MANIFEST          "<sha256>  <path>" lines, paths relative to /
#   <paths...>        the actual files (same relative layout as the root fs)
#
# Behaviour:
#   * verifies every file against MANIFEST BEFORE touching the system
#   * backs up every file it replaces to /var/backups/osupdate-<stamp>/
#   * writes files via tmp+rename, so an interrupted update leaves whole files
#   * logs to /var/lib/constellation/osupdate.log
#
# Usage:
#   osupdate                 apply the newest *.upd found on the USB stick
#   osupdate --list          show bundles on the stick without applying
#   osupdate --dry-run       verify + show what would change, touch nothing
#   osupdate --from PATH     apply a specific bundle
#   osupdate --rollback DIR  restore the files saved in a backup directory
set -u
PATH=/bin:/sbin:/usr/bin:/usr/sbin

USB=/media/usb
BKROOT=/var/backups
LOGDIR=/var/lib/constellation
LOG=$LOGDIR/osupdate.log

say() { echo "osupdate: $*"; }
die() { echo "osupdate: $*" >&2; exit 1; }

usage() {
  cat <<'USAGE'
osupdate -- install a Constellation OS .upd bundle from a USB stick

  osupdate                  apply the newest bundle found under /media/usb
  osupdate --list           list bundles found, with their VERSION line
  osupdate --dry-run        verify checksums, show what would change
  osupdate --from PATH      apply a specific bundle
  osupdate --rollback DIR   restore the files saved in a backup directory
  osupdate --help           this text

Behaviour:
  Every file is verified against MANIFEST before anything is touched. Each
  replaced file is copied to /var/backups/osupdate-<stamp>/ first, and every
  write goes tmp+rename, so an interrupted update leaves whole files.
  The log is /var/lib/constellation/osupdate.log.

Space:
  A full rootfs bundle is 38 MiB compressed and about 100 MiB unpacked. The
  work directory is /var/tmp, on the root filesystem -- /tmp is a 16 MiB
  tmpfs and cannot hold it. Set WORKDIR=/some/dir to use another place.
USAGE
}

case ${1:-} in
  -h|--help) usage; exit 0 ;;
esac

mkdir -p "$LOGDIR" "$BKROOT"
log() { echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> "$LOG" 2>/dev/null; }

# ---- rollback (restore a previous backup dir) ----------------------------
if [ "${1:-}" = "--rollback" ]; then
  src=${2:-}
  [ -n "$src" ] || die "--rollback needs a backup directory"
  [ -d "$src" ] || die "no such backup directory: $src"
  n=0
  ( cd "$src" && find . -type f ) | while read -r f; do
    rel=${f#./}
    mkdir -p "/$(dirname "$rel")" 2>/dev/null
    if cp "$src/$rel" "/$rel.osupdate.tmp" 2>/dev/null && mv -f "/$rel.osupdate.tmp" "/$rel"; then
      log "rolled back $rel"
      n=$((n + 1))
    else
      echo "osupdate: rollback failed for /$rel" >&2
    fi
  done
  sync
  say "rollback from $src complete"
  exit 0
fi

# ---- find the bundle ------------------------------------------------------
bundle=
case ${1:-} in
  --from) bundle=${2:-}; [ -n "$bundle" ] || die "--from needs a path" ;;
esac

find_bundles() {
  dirs="$USB /media /mnt"
  for d in $dirs; do
    [ -d "$d" ] || continue
    find "$d" -maxdepth 2 -name 'constellation-*.upd' -o -maxdepth 2 -name '*.upd' 2>/dev/null
  done | sort -u
}

if [ -z "$bundle" ]; then
  bundles=$(find_bundles)
  # Nothing found: the stick may be plugged in but not mounted. There is no
  # udev in this image, so mount it by hand (mountusb is the same script the
  # login banner advertises) and look again.
  if [ -z "$bundles" ] && [ -x /usr/bin/mountusb ]; then
    if ! mountpoint -q "$USB" 2>/dev/null; then
      say "no bundle found; trying to mount the USB stick"
      /usr/bin/mountusb >/dev/null 2>&1 || true
      bundles=$(find_bundles)
    fi
  fi
  [ -n "$bundles" ] || {
    say "no *.upd bundle found on the USB stick ($USB)"
    say "  plug the stick in, or use: osupdate --from /path/to/x.upd"
    exit 1; }
  echo "bundles found:"
  echo "$bundles" | while read -r b; do
    [ -n "$b" ] || continue
    # The archive stores "./VERSION"; plain "VERSION" does not match.
    v=$(tar -xzOf "$b" ./VERSION 2>/dev/null | head -n 3 | tr '\n' ' ')
    [ -n "$v" ] || v=$(tar -xzOf "$b" VERSION 2>/dev/null | head -n 3 | tr '\n' ' ')
    printf '  %s\n    %s\n' "$b" "$v"
  done
  case ${1:-} in
    --list) exit 0 ;;
  esac
  # Newest by modification time. Names carry a date, but mtime is the fact.
  bundle=$(echo "$bundles" | while read -r b; do
             [ -n "$b" ] || continue
             echo "$(stat -c %Y "$b" 2>/dev/null || echo 0) $b"
           done | sort -n | tail -n 1 | cut -d' ' -f2-)
  [ -n "$bundle" ] || bundle=$(echo "$bundles" | tail -n 1)
  case ${1:-} in
    --from) ;;
    *) say "using $bundle" ;;
  esac
fi
[ -f "$bundle" ] || die "bundle not found: $bundle"

# ---- verify into a work dir ---------------------------------------------
# NOT /tmp: init mounts a 16 MiB tmpfs there, and a full rootfs bundle unpacks
# to about 100 MiB. /var/tmp lives on the root filesystem, which has the room.
WORKDIR=${WORKDIR:-/var/tmp}
mkdir -p "$WORKDIR" 2>/dev/null || WORKDIR=/var
TMP=$(mktemp -d "$WORKDIR/osupdate.XXXXXX") || die "mktemp failed in $WORKDIR"
trap 'rm -rf "$TMP"' EXIT HUP INT TERM

# Preflight: a 38 MiB bundle becomes ~100 MiB on disk. Fail before extracting,
# not halfway through with "cannot extract".
need=$(tail -c 4 "$bundle" | od -An -tu4 | tr -d ' \n')
case $need in ''|*[!0-9]*) need=0 ;; esac
if [ "$need" -gt 0 ]; then
  need=$((need / 1024 + 2048))          # KiB, plus 2 MiB of slack
  avail=$(df -k "$WORKDIR" 2>/dev/null | awk 'NR == 2 { print $4 }')
  case $avail in ''|*[!0-9]*) avail=0 ;; esac
  if [ "$avail" -gt 0 ] && [ "$need" -gt "$avail" ]; then
    die "not enough space in $WORKDIR: need ${need} KiB, ${avail} KiB free"
  fi
  say "work dir $TMP (needs ${need} KiB, ${avail} KiB free)"
fi

say "extracting $bundle ..."
if ! tar -xzf "$bundle" -C "$TMP"; then
  avail=$(df -k "$TMP" 2>/dev/null | awk 'NR == 2 { print $4 }')
  [ -n "$avail" ] && avail="$avail KiB free in $TMP" || avail="$TMP"
  die "cannot extract $bundle ($avail). Either the bundle is truncated --
  check sha256 of the copy on the stick against the host build -- or the
  medium is full. A stick removed without umounting gives a truncated file."
fi
[ -f "$TMP/MANIFEST" ] || die "bundle has no MANIFEST"

say "verifying checksums ..."
# busybox's sha256sum has no --quiet: run the plain check and count FAILED lines.
bad=$( cd "$TMP" && sha256sum -c MANIFEST 2>/dev/null | grep -c 'FAILED' )
[ "$bad" = 0 ] || die "checksum verification failed ($bad bad files) -- nothing changed"

ver=$(head -n 1 "$TMP/VERSION" 2>/dev/null)
say "bundle OK: ${ver:-unknown version}"

# ---- plan ---------------------------------------------------------------
changed=0; added=0
plan=
while read -r sum path; do
  [ -n "${path:-}" ] || continue
  case $path in MANIFEST|VERSION) continue ;; esac
  [ -f "$TMP/$path" ] || continue
  if [ -f "/$path" ]; then
    if [ "$(sha256sum "/$path" 2>/dev/null | cut -d' ' -f1)" = "$sum" ]; then
      continue                     # identical, skip
    fi
    plan="$plan M $path"; changed=$((changed + 1))
  else
    plan="$plan A $path"; added=$((added + 1))
  fi
done < "$TMP/MANIFEST"

say "$changed file(s) to replace, $added new file(s)"
if [ "${1:-}" = "--dry-run" ]; then
  echo "$plan" | awk '{ for (i = 1; i <= NF; i += 2) print "  " $i, $(i+1) }' | head -n 40
  say "dry run: nothing was changed"
  exit 0
fi
[ "$changed" = 0 ] && [ "$added" = 0 ] && { say "already up to date"; exit 0; }

# ---- apply --------------------------------------------------------------
stamp=$(date '+%Y%m%d-%H%M%S')
bk=$BKROOT/osupdate-$stamp
mkdir -p "$bk"
say "backup dir: $bk"

fail=0
# busybox has no paste: use awk to turn "A p1 M p2 ..." into "A p1" lines
echo "$plan" | awk '{ for (i = 1; i <= NF; i += 2) print $i, $(i+1) }' > "$TMP/.plan"

while read -r act path; do
  [ -n "${path:-}" ] || continue
  case $path in
    /*|../*|*/../*) die "refusing unsafe path in manifest: $path" ;;
  esac
  dir=$(dirname "/$path")
  mkdir -p "$dir" 2>/dev/null || true
  if [ "$act" = "M" ]; then
    mkdir -p "$bk/$(dirname "$path")" 2>/dev/null
    cp -p "/$path" "$bk/$path" 2>/dev/null || true
  fi
  if cp "$TMP/$path" "$dir/.osupdate.tmp" 2>/dev/null && mv -f "$dir/.osupdate.tmp" "/$path"; then
    log "installed $path ($act)"
  else
    echo "osupdate: failed to install /$path" >&2
    log "FAILED $path"
    fail=$((fail + 1))
  fi
done < "$TMP/.plan"

sync
log "update applied from $bundle: $changed replaced, $added added, $fail failed"
if [ "$fail" -gt 0 ]; then
  say "$fail file(s) failed; backups in $bk"
  say "roll back with: osupdate --rollback $bk"
  exit 1
fi
say "done. if the kernel or boot files changed, reboot to use them."
say "roll back with: osupdate --rollback $bk"
