#!/bin/sh
# Kernel uevent helper (CONFIG_UEVENT_HELPER_PATH="/sbin/hotplug").
# Its only job: resolve MODALIAS to a driver and load it.
#
# Covered scenarios are the two CardBus slots of the 770ED:
#   - 16-bit PC Card (pcnet_cs / 3c589_cs / serial_cs / CF adapter) -> pcmcia:
#   - CardBus card (8139too / e1000 / ath5k / b43 ...)               -> pci:
#   - USB device in the built-in UHCI ports                          -> usb:
# Nothing matches: exit quietly (modprobe -q).
[ "$ACTION" = "add" ] || exit 0
[ -n "$MODALIAS" ] || exit 0
exec /sbin/modprobe -q "$MODALIAS"
