#!/bin/sh
# Kernel uevent helper (CONFIG_UEVENT_HELPER_PATH="/sbin/hotplug").
#
# Two jobs:
#   1) load the driver for a new device, by MODALIAS
#      - 16-bit PC Card (pcnet_cs / 3c589_cs / serial_cs / CF adapter)
#      - CardBus card (8139too / e1000 / ath5k / b43 ...)
#      - USB device on the built-in UHCI ports
#   2) automount a removable USB stick on /media/usb (and unmount on removal).
#      There is no udev here, so this is the whole automounter.
ACTION=${ACTION:-}
PATH=/bin:/sbin:/usr/bin:/usr/sbin

# ---- 1) removable media (block partitions) ----
if [ "$SUBSYSTEM" = "block" ] && [ "$DEVTYPE" = "partition" ]; then
  disk=$(echo "${DEVPATH:-}" | sed 's|.*/block/\([^/]*\)/.*|\1|')
  case $disk in
    sd*|mmcblk*) ;;
    *) exit 0 ;;
  esac
  # Only removable media: the CF card (Internal IDE) must stay untouched.
  if [ "$(cat "/sys/block/$disk/removable" 2>/dev/null)" != 1 ]; then
    exit 0
  fi
  dev="/dev/${DEVNAME:-$(echo "${DEVPATH##*/}")}"
  [ -b "$dev" ] || exit 0

  if [ "$ACTION" = "add" ]; then
    # already mounted somewhere else? leave it alone
    grep -q "^$dev " /proc/mounts && exit 0
    mkdir -p /media/usb 2>/dev/null || exit 0
    type=$(blkid -o value -s TYPE "$dev" 2>/dev/null)
    case $type in
      vfat|fat|msdos) set -- -t vfat -o iocharset=utf8,umask=022 ;;
      exfat)          set -- -t exfat -o iocharset=utf8,umask=022 ;;
      ntfs)           set -- -t ntfs -o umask=022 ;;
      ext2|ext3|ext4) set -- -t "$type" ;;
      *)              set -- "" ;;
    esac
    if mount "$@" "$dev" /media/usb 2>/dev/null; then
      echo "constellation: $dev mounted on /media/usb" > /dev/kmsg 2>/dev/null || true
    fi
    exit 0
  fi

  if [ "$ACTION" = "remove" ]; then
    if awk -v d="$dev" '$1 == d && $2 == "/media/usb" { found = 1 } END { exit !found }' /proc/mounts; then
      sync
      umount /media/usb 2>/dev/null
      rmdir /media/usb 2>/dev/null
    fi
    exit 0
  fi
  exit 0
fi

# ---- 2) driver loading for everything else ----
[ "$ACTION" = "add" ] || exit 0
[ -n "${MODALIAS:-}" ] || exit 0
exec /sbin/modprobe -q "$MODALIAS"
