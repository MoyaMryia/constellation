#!/bin/sh
# Constellation OS -- PID 1 for the ThinkPad 770ED.
#
# Same structure as the other flavors: mount pseudo filesystems -> set up zram
# swap -> load the 770ED-specific drivers on demand -> exec s6-svscan.
#
# Three differences from the X61 flavor:
#   1) No ACPI, only APM 1.2: /proc/apm comes from the kernel APM driver;
#      suspend/resume is driven by the BIOS, no user-space daemon needed.
#   2) The display is a Trident Cyber9397 whose fb driver (tridentfb) is a
#      module: it must be loaded before getty, otherwise tty1 stays in VGA text
#      80x25 until somebody runs modprobe.
#   3) The sound chip is an ISA PnP CS4237B, also a module; a load failure must
#      not block booting (some BIOSes disable audio, or the resources are held
#      by the Cat DSP).
export PATH=/bin:/sbin:/usr/bin:/usr/sbin

# Mind the order and the redirections: you **cannot** write `2>/dev/null` here.
# /dev is still an empty directory at this point (this flavor does not set
# CONFIG_DEVTMPFS_MOUNT), and ash skips the whole command when a redirection
# fails -- so the mount never happens, `grep /proc/mounts || exec sh` drops to a
# shell, and the symptom is "it booted, no hostname, every command says not
# found".
mountpoint -q /dev  || mount -t devtmpfs devtmpfs /dev
mountpoint -q /proc || mount -t proc proc /proc
mountpoint -q /sys  || mount -t sysfs sysfs /sys
# devpts: terminal emulators (st/xterm) need openpty(); without /dev/ptmx they
# report "openpty failed". devtmpfs only provides the /dev/ptmx node -- the pty
# master/slave pairs come from devpts.
mkdir -p /dev/pts
mountpoint -q /dev/pts || mount -t devpts devpts /dev/pts -o gid=5,mode=0620


grep -q '^proc /proc proc' /proc/mounts || exec sh
grep -q '^sysfs /sys sysfs' /proc/mounts || exec sh

mount -o remount,rw / || exec sh

# /tmp on tmpfs: without isolation, leftovers such as Xorg's /tmp/.X0-lock or
# build intermediates survive a reboot (typical symptom: the second startx
# reports "Server is already active for display 0"). Also saves flash writes.
mountpoint -q /tmp || mount -t tmpfs -o size=16M,mode=1777 tmpfs /tmp || true
hostname "$(cat /etc/hostname)"

# Hotplug: after a CardBus card is inserted the kernel sends a uevent and this
# helper hands MODALIAS to modprobe. No udev, no systemd -- this line is all the
# "automatic driver loading" there is.
if [ -w /proc/sys/kernel/hotplug ]; then
  echo /sbin/hotplug > /proc/sys/kernel/hotplug 2>/dev/null || true
fi

# Coldplug: populate device nodes that already existed at boot time (CardBus
# slots, USB ports).
/bin/mdev -s 2>/dev/null || true

# Order matters: this must run AFTER "mdev -s". mdev recreates nodes according
# to /etc/mdev.conf and resets the modes (that is how /dev/null went back to 0660).
for d in null zero full random urandom tty; do
  [ -c "/dev/$d" ] && chmod 666 "/dev/$d" 2>/dev/null
done

# Drivers for the fixed on-board devices. All are modules; order does not
# matter and failures are harmless:
#   tridentfb     -- 1024x768-16 panel mode, see /etc/modprobe.d/tridentfb.conf
#   snd-cs4236    -- CS4237B, ISA PnP probing
#   floppy        -- APM suspend wants it, even without a drive attached
#   zram          -- zram is a module in the 6.6 flavor (built in for 6.18,
#                    where modprobe fails silently)
#   snd-mixer-oss -- provides /dev/mixer for /bin/mixer volume control
#   snd-pcm-oss   -- provides /dev/dsp and /dev/audio (needed by mpg123/tone)
#   ppp_generic   -- creates /dev/ppp (modem character device, no bus modalias)
# usbhid / usb-storage / uas must be loaded up front: there is no udev here.
# The uevent helper is only used by the coldplug modalias loop below, so a stick
# or keyboard plugged in at runtime has nothing to modprobe for it -- if the
# module is not loaded, the device is never bound.
for m in tridentfb snd-cs4236 snd-mixer-oss snd-pcm-oss floppy zram ppp_generic \
         usbhid usb-storage uas; do
  /sbin/modprobe -q "$m" 2>/dev/null || true
done

# Coldplug: PCI/USB/PnP/PCMCIA devices that existed before boot never send a
# uevent, so walk their modalias files and load the matching driver by hand.
#
# BusyBox modprobe cannot resolve a modalias on its own -- given
# "pci:v00001022d00002000sv..." it answers "not found in modules.dep". Only
# the real kmod/libkmod does alias lookup. So do the lookup here: match each
# modalias against modules.alias, then modprobe the module name it names.
# Without this a CardBus NIC is never claimed by its driver, and the machine
# ends up with no network until somebody types "modprobe 3c59x" by hand.
ALIASFILE=$(ls /lib/modules/*/modules.alias 2>/dev/null | head -n 1)
if [ -n "$ALIASFILE" ]; then
  : > /tmp/.modalias
  for mf in /sys/bus/pci/devices/*/modalias /sys/bus/usb/devices/*/modalias \
            /sys/bus/pnp/devices/*/modalias /sys/bus/pcmcia/devices/*/modalias; do
    [ -r "$mf" ] && cat "$mf" >> /tmp/.modalias
  done
  sort -u /tmp/.modalias > /tmp/.modalias.u 2>/dev/null || :
  # modules.alias patterns are globs; turn them into anchored regexes.
  awk '
    NR == FNR { dev[++n] = $0; next }
    $1 == "alias" {
      r = $2
      gsub(/\./, "\\.", r)
      gsub(/\*/, ".*", r)
      for (i = 1; i <= n; i++)
        if (dev[i] ~ "^" r "$") { print $3; break }
    }
  ' /tmp/.modalias.u "$ALIASFILE" | sort -u > /tmp/.coldplug 2>/dev/null || :
  while read -r m; do
    [ -n "$m" ] || continue
    /sbin/modprobe -q "$m" 2>/dev/null || true
  done < /tmp/.coldplug
  rm -f /tmp/.modalias /tmp/.modalias.u /tmp/.coldplug
fi

# Real swap partition (mkimage passes cswap=/dev/sdaX on the command line).
# Only ever use what the command line says -- never guess the device: whether the
# layout is p2=swap/p3=root or p2=root, guessing wrong once means running
# mkswap on the root partition. On first boot the partition has no swap
# signature yet, so mkswap it and enable it.
SWAPDEV=
for arg in $(cat /proc/cmdline); do
  case "$arg" in cswap=*) SWAPDEV=${arg#cswap=} ;; esac
done
if [ -n "$SWAPDEV" ] && [ -b "$SWAPDEV" ]; then
  if swapon "$SWAPDEV" 2>/dev/null; then
    echo "constellation: swap on $SWAPDEV"
  elif mkswap "$SWAPDEV" >/dev/null 2>&1 && swapon "$SWAPDEV" 2>/dev/null; then
    echo "constellation: swap formatted and enabled on $SWAPDEV"
  else
    echo "constellation: $SWAPDEV swap enable failed"
  fi
fi

# zram swap: on a 64 MiB machine this is the cheapest available extra memory.
if [ -e /sys/block/zram0/disksize ]; then
  ZRAM_SIZE=${ZRAM_SIZE:-16777216}
  echo "$ZRAM_SIZE" > /sys/block/zram0/disksize 2>/dev/null
  if mkswap /dev/zram0 >/dev/null 2>&1 && swapon /dev/zram0 2>/dev/null; then
    echo "constellation: zram0 swap on ($ZRAM_SIZE bytes)"
  else
    echo "constellation: zram0 swap setup failed"
  fi
fi

echo 'Constellation (ThinkPad 770ED): starting s6-svscan'
exec s6-svscan /etc/s6
