#!/bin/sh
# Constellation OS M1 initramfs /init
# Boots the minimal core to a shell.

export PATH=/bin

/bin/busybox --install -s /bin 2>/dev/null

mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev

hostname constellation

echo
echo "Constellation OS M1: minimal kernel + BusyBox initramfs"
echo "======================================================="
uname -a
echo
echo "-- /proc/meminfo --"
cat /proc/meminfo
echo "-- /proc/meminfo end --"
echo
echo "Dropping to shell."
exec /bin/sh
