# Constellation OS — ThinkPad 770ED 追加的 BusyBox applet
#
# 基线是 busybox/configs/busybox-1.38.0-M1.config，再叠
# busybox/configs/busybox-1.38.0-amd64.fragment（同一 BusyBox 版本、
# 与架构无关的通用命令行工具集）。本文件只补 770ED 这台机器才需要的
# 硬件勘察/热插拔工具。
#
# 应用顺序见 scripts/build-core-770ed.sh：M1 → amd64 fragment → 本文件。

# 静态链接（defconfig 默认是动态；镜像里没有 ld.so 供 busybox 用）
CONFIG_STATIC=y
# 目标 CPU 是 Pentium II：没有 SSE/SSE2/3DNow。defconfig 基线不带这些开关，
# 缺了它 gcc 会按宿主默认（i686+）生成代码，实测 busybox 里混进 291 条 xmm
# 指令（sha256sum 之类），PII 上直接 SIGILL。
CONFIG_EXTRA_CFLAGS="-Os -march=i486 -mno-sse -mno-sse2 -mno-mmx -mno-3dnow -fno-stack-protector"

# --- 设备节点与热插拔 ---
# devtmpfs 已经给出静态节点；mdev 补的是冷插拔（启动时已插入的 CardBus
# 卡）与后续 mdev -s 的 /dev 补齐。
CONFIG_MDEV=y
# CONF 才是"读 /etc/mdev.conf 规则"；RENAME 只是允许重命名/建软链动作。
# 少了 CONF，mdev 会无视 mdev.conf（症状：/dev/mouse 这类兼容软链不出现）。
CONFIG_FEATURE_MDEV_CONF=y
CONFIG_FEATURE_MDEV_RENAME=y

# --- 硬件勘察：本机全部验收都靠这几条命令 ---
# lspci/lsusb 从 sysfs 读，不需要外部 libpci/libusb。
CONFIG_LSPCI=y
CONFIG_LSUSB=y
# 帧缓冲模式查询/切换：验证 tridentfb 真的绑上了 1024x768。
CONFIG_FBSET=y
# CMOS 时钟：APM 挂起/恢复后对时。
CONFIG_HWCLOCK=y
# 查模块信息与依赖链（解释某张 PCMCIA 卡为什么没绑上驱动）。
CONFIG_MODINFO=y
# dmesg：串口上没有 console 时也能在 shell 里回看内核日志（真机排障必备）
CONFIG_DMESG=y
# X 在 VT2 上跑，退出后切回 VT1 上的 getty。
CONFIG_CHVT=y
# ash 内的 $(( )) 数学展开：脚本里写计数器/位移时很常见。没开的话报
# "support for $((arith)) is disabled" 并让整条命令失败（/usr/bin/x 就中过）。
# 正确的符号名是 FEATURE_SH_MATH（不是 ASH_MATH_SUPPORT——那个名字写错会
# 被 Kconfig 静默丢掉，症状就是 "$((arith)) is disabled"）。
CONFIG_FEATURE_SH_MATH=y
CONFIG_FEATURE_SH_MATH_64=y

# ---- 行编辑 / 历史 / 补全：没有这些，ash 连上下键翻历史都不支持 ----
# FEATURE_EDITING 关着时 MAX_LEN 与 HISTORY 都是 0，表现就是方向键没反应、
# Ctrl-A 不跳到行首、Tab 不补全。打开后 ash 自带行编辑器（不需要 readline）。
CONFIG_FEATURE_EDITING=y
CONFIG_FEATURE_EDITING_MAX_LEN=1024
CONFIG_FEATURE_EDITING_HISTORY=200
CONFIG_FEATURE_EDITING_SAVEHISTORY=y
CONFIG_FEATURE_TAB_COMPLETION=y
# FANCY_PROMPT 才会解释 PS1 里的 \u \h \w \$（/etc/profile 用到）
CONFIG_FEATURE_EDITING_FANCY_PROMPT=y

# ---- 常用但默认没开的 applet ----
CONFIG_LESS=y
CONFIG_XXD=y
CONFIG_UNZIP=y
CONFIG_BLKID=y
CONFIG_FDISK=y
CONFIG_LOGGER=y
CONFIG_CROND=y
CONFIG_SYSCTL=y

# `busybox --list` / `busybox --install` 需要它。build-rootfs 靠 --list 生成
# /bin/* 的 applet 软链，没有这个开关就一条软链都建不出来 —— 镜像里会没有
# /bin/sh、/bin/ls，登录后直接"没有 shell"。
# BUSYBOX 这个"applet"本身必须开：它提供 `busybox --list/--install/--help`
# 这条多路复用入口，同时 FEATURE_INSTALLER 依赖它。M1 配置里是关的（M1 只把
# busybox 当 init 用），于是 build-rootfs 的 `busybox --list` 输出为空 →
# /bin 下一条 applet 软链都建不出来 → 镜像里没有 /bin/sh、/bin/ls。
CONFIG_BUSYBOX=y
CONFIG_FEATURE_INSTALLER=y

# SHA-NI 硬件加速：代码用 __attribute__((target("sha,sse4.1"))) 编，二进制里
# 会有 movups/xorps/pinsrd（实测 291 条）。PII 没有这些指令，运行期即便有
# cpuid 保护也不值得留 —— 直接关掉，审计才干净。
# CONFIG_SHA1_HWACCEL is not set
# CONFIG_SHA256_HWACCEL is not set

# modprobe **必须**用完整版（不是 modprobe-small）。modprobe-small 不读
# /etc/modprobe.d/*.conf，也不给模块传 options —— 实测后果：
#   tridentfb 的 mode=1024x768-16@60 fp=1 被完全忽略，fb0 起来是 640x480-8bpp
#   （dmesg: "tridentfb: 1024x768 flat panel found" 但 "frame buffer device 640x480-8bpp"）
#   snd-cs4236 的 index/资源参数同理丢失。
# CONFIG_MODPROBE_SMALL is not set
CONFIG_MODPROBE=y
